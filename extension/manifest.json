{
  "manifest_version": 3,
  "name": "Localhost Tab Titles",
  "version": "1.0.0",
  "description": "Name localhost tabs after the project or git worktree serving them, plus the port, so dev servers are easy to tell apart.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "host_permissions": ["http://127.0.0.1:47123/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "https://localhost/*", "http://127.0.0.1/*", "http://0.0.0.0/*"],
      "js": ["title.js"],
      "run_at": "document_start"
    }
  ]
}
