{
  "manifest_version": 3,
  "name": "Localhost Tab Titles",
  "version": "1.0.0",
  "description": "Name localhost tabs after the project or git worktree serving them, plus the port, so dev servers are easy to tell apart.",
  "key": "",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Localhost Tab Titles",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "permissions": ["nativeMessaging", "storage", "activeTab"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "https://localhost/*",
        "http://127.0.0.1/*",
        "https://127.0.0.1/*",
        "http://0.0.0.0/*",
        "http://*.localhost/*",
        "https://*.localhost/*",
        "http://[::1]/*"
      ],
      "js": ["title.js"],
      "run_at": "document_start"
    }
  ]
}
